@using GestaoDeEquipamentos.Dominio
@using GestaoDeEquipamentos.WebApp.Models

@model ExcluirFabricanteViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Fabricante";
}

<html>
<body data-bs-theme="dark">
    <div class="container my-2">
        <form action="/Fabricante/ExcluirConfirmado/@Model.Id" method="post">
            <p class="fw-bold">Deseja realmente excluir o registro "@Model.Nome"?</p>

            <a class="btn btn-secondary" href="/Fabricante">Voltar</a>
            <button class="btn btn-danger">Excluir</button>
        </form>
    </div>
</body>
</html>