@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Fabricante";
}

<html>

<body data-bs-theme="dark">
    <main class="container my-4">
        <form class="col-4" action="/Fabricante/Cadastrar" method="post">
            <div class="mb-3">
                <label class="form-label">Nome:</label>
                <input name="Nome" type="text" class="form-control" value="@Model.Nome" placeholder="Digite o nome do fabricante...">
            </div>

            <div class="mb-3">
                <label class="form-label">Email:</label>
                <input name="Email" type="email" class="form-control" value="@Model.Email" placeholder="Digite o email do fabricante...">
            </div>

            <div class="mb-3">
                <label class="form-label">Telefone:</label>
                <input name="Telefone" type="tel" class="form-control" value="@Model.Telefone" placeholder="Digite o telefone do fabricante...">
            </div>

            <div class="d-flex justify-content-end">
                <a class="btn btn-secondary px-4 me-1" href="/Fabricante">Voltar</a>
                <button class="btn btn-success px-4" type="submit">Salvar</button>
            </div>
        </form>
    </main>
</body>
</html>