@using GestaoDeEquipamentos.Dominio
@using GestaoDeEquipamentos.WebApp.Models

@model VisualizarFabricantesViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Fabricantes";
}

<html>
<body>
    <div>
        <a class="btn btn-primary mb-3" href="/Fabricante/Cadastrar"><i class="bi bi-plus-circle"></i> Cadastrar</a>
    </div>

    @* Conteúdo principal da página *@
    <main>
        <div class="row g-2">
            @foreach (DetalhesFabricanteViewModel f in Model.Registros)
            {
                <div class="col-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@f.Nome</h5>
                            <p class="card-text mb-0"><strong>Email: </strong>@f.Email</p>
                            <p class="card-text mb-0"><strong>Telefone: </strong>@f.Telefone</p>
                        </div>

                        <div class="card-actions ms-auto me-3 mb-3 d-flex gap-1">
                            <a class="btn btn-sm btn-primary rounded-circle d-flex justify-content-center align-items-center" style="height:30px" href="/Fabricante/Editar/@f.Id"><i class="bi bi-pencil"></i></a>
                            <a class="btn btn-sm btn-danger rounded-circle d-flex justify-content-center align-items-center" style="height:30px" href="/Fabricante/Excluir/@f.Id"><i class="bi bi-trash"></i></a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>
</body>
</html>