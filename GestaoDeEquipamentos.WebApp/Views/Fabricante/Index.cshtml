@using GestaoDeEquipamentos.Dominio
@model List<Fabricante>

<h1>Visualização de Fabricante</h1>

<hr />

<a href="/Fabricante/Cadastrar">Cadastrar Novo Fabricante</a>

<ul>
    @foreach (Fabricante manufactor in Model)
    {
        <li>@manufactor.Name / @manufactor.Email / @manufactor.Phone / 
            <a href="/Fabricante/Editar/@manufactor.Id">Editar</a>
            <a href="/Fabricante/Excluir/@manufactor.Id">Excluir</a>
        </li>
    }
</ul>