@using GestaoDeEquipamentos.Dominio
@using GestaoDeEquipamentos.WebApp.Models

@model EditarFabricanteViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Fabricante";
}

<html>
<body>
    <main class="container my-2">
        <form class="col-4" action="/Fabricante/Editar/@Model.Id" method="post">
            <div class="mb-3">
                <label class="form-label">Nome:</label>
                <input name="Nome" type="text" class="form-control" value="@Model.Nome">
            </div>

            <div class="mb-3">
                <label class="form-label">Email:</label>
                <input name="Email" type="email" class="form-control" value="@Model.Email">
            </div>

            <div class="mb-3">
                <label class="form-label">Telefone:</label>
                <input name="Telefone" type="tel" class="form-control" value="@Model.Telefone">
            </div>

            <div class="d-flex justify-content-end">
                <a class="btn btn-secondary me-1" href="/Fabricante">Voltar</a>
                <button class="btn btn-success" type="submit">Salvar</button>
            </div>
        </form>
    </main>
</body>
</html>