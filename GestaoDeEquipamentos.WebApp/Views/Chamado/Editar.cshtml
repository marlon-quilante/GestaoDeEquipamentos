@using GestaoDeEquipamentos.Dominio
@using GestaoDeEquipamentos.WebApp.Models

@model EditarChamadoViewModel;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Chamado";
}

<html>
<body data-bs-theme="dark">
    <main class="container my-2">
        <form class="col-4" action="/Chamado/Editar/@Model.Id" method="post">
            <div class="mb-3">
                <label for="Titulo" class="form-label">Titulo:</label>
                <input name="Titulo" type="text" value="@Model.Titulo" class="form-control">
            </div>

            <div class="mb-3">
                <label for="Descricao" class="form-label">Descrição:</label>
                <textarea name="Descricao" class="form-control">@Model.Descricao</textarea>
            </div>

            <div class="mb-3">
                <label for="EquipamentoID" class="form-label">Equipamento:</label>
                <select class="form-select" name="EquipamentoId">
                    @foreach (SelecionarEquipamentoViewModel e in Model.Equipamentos)
                    {
                        <option value="@e.Id">@e.Nome</option>
                    }
                </select>
            </div>

            <div class="d-flex justify-content-end">
                <a class="btn btn-secondary px-4 me-1" href="/Chamado">Voltar</a>
                <button class="btn btn-success px-4" type="submit">Salvar</button>
            </div>
        </form>
    </main>

</body>

</html>