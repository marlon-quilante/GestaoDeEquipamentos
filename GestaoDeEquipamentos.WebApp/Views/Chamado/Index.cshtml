@using GestaoDeEquipamentos.Dominio
@using GestaoDeEquipamentos.WebApp.Models

@model VisualizarChamadosViewModels;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Chamados";
}

<html>
<body>
    <div>
        <a class="btn btn-primary mb-3" href="/Chamado/Cadastrar"><i class="bi bi-plus-circle"></i> Cadastrar</a>
    </div>

    <main>
        <div class="row g-2">
            @foreach (DetalhesChamadoViewModel c in Model.Registros)
            {
                <div class="col-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@c.Titulo</h5>
                            <p class="card-text mb-0"><strong>Descrição:</strong> @c.Descricao</p>
                            <p class="card-text mb-0"><strong>Data de Abertura:</strong> @c.DataAbertura.ToShortDateString()</p>
                            <p class="card-text mb-0"><strong>Equipamento:</strong> @c.NomeEquipamento</p>
                        </div>

                        <div class="card-actions ms-auto me-3 mb-3 d-flex gap-1">
                            <a class="btn btn-sm btn-primary rounded-circle d-flex justify-content-center align-items-center" style="height:30px" href="/Chamado/Editar/@c.Id">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-sm btn-danger rounded-circle d-flex justify-content-center align-items-center" style="height:30px" href="/Chamado/Excluir/@c.Id">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>
</body>
</html>