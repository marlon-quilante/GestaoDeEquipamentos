@using GestaoDeEquipamentos.WebApp.Models;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Abertura de Chamado";
}

<html>

<body>
    <main class="container my-4">
        <form class="col-4" action="/Chamado/Cadastrar" method="post">
            <div class="mb-3">
                <label for="Titulo" class="form-label">Título:</label>
                <input name="Titulo" type="text" class="form-control" placeholder="Digite o título do chamado...">
            </div>

            <div class="mb-3">
                <label for="Descricao" class="form-label">Descrição:</label>
                <textarea name="Descricao" type="number" class="form-control" value="" placeholder="Digite a descrição do chamado..."></textarea>
            </div>

            <div class="mb-3">
                <label for="DataAbertura" class="form-label">Data de Abertura:</label>
                <input name="DataAbertura" type="date" class="form-control">
            </div>

            <div class="mb-3">
                <label for="EquipamentoID" class="form-label">Equipamento:</label>
                <select class="form-select" name="EquipamentoID">
                    @foreach (SelecionarEquipamentoViewModel e in Model.Equipamentos)
                    {
                        <option value="@e.Id">@e.Nome</option>
                    }
                </select>
            </div>

            <div class="d-flex justify-content-end">
                <a class="btn btn-secondary px-4 me-1" href="/Chamado">Voltar</a>
                <button class="btn btn-success px-4" type="submit">Salvar</button>
            </div>
        </form>
    </main>
</body>
</html>