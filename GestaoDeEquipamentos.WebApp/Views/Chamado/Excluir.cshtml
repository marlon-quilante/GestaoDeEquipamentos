@using GestaoDeEquipamentos.Dominio
@using GestaoDeEquipamentos.WebApp.Models

@model ExcluirChamadoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Chamado";
}

<html>
<body>
    <div>
        <form action="/Chamado/ExcluirConfirmado/@Model.Id" method="post">
            <p class="fw-bold">Deseja realmente excluir o registro "@Model.Titulo"?</p>

            <a class="btn btn-secondary" href="/Chamado">Voltar</a>
            <button class="btn btn-danger">Excluir</button>
        </form>
    </div>
</body>
</html>