@using GestaoDeEquipamentos.Dominio
@using GestaoDeEquipamentos.WebApp.Models

@model VisualizarEquipamentosViewModels

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Equipamentos";
}

<html>
<body>
    <div>
        <a class="btn btn-primary mb-3" href="/Equipamento/Cadastrar"><i class="bi bi-plus-circle"></i> Cadastrar</a>
    </div>

    <main>
        <div class="row g-2">
            @foreach (DetalhesEquipamentoViewModel e in Model.Registros)
            {
                <div class="col-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@e.Nome</h5>
                            <p class="card-text mb-0"><strong>Número de Série:</strong> @e.NumeroSerie</p>
                            <p class="card-text mb-0"><strong>Preço:</strong> @e.Preco.ToString("C2")</p>
                            <p class="card-text mb-0"><strong>Data de Fabricação:</strong> @e.DataFabricacao.ToShortDateString()</p>
                            <p class="card-text mb-0"><strong>Fabricante:</strong> @e.NomeFabricante</p>
                        </div>

                        <div class="card-actions ms-auto me-3 mb-3 d-flex gap-1">
                            <a class="btn btn-sm btn-primary rounded-circle d-flex justify-content-center align-items-center" style="height:30px" href="/Equipamento/Editar/@e.Id">
                                <i class="bi bi-pencil"></i></a>
                            <a class="btn btn-sm btn-danger rounded-circle d-flex justify-content-center align-items-center" style="height:30px" href="/Equipamento/Excluir/@e.Id">
                                <i class="bi bi-trash"></i></a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>
</body>
</html>