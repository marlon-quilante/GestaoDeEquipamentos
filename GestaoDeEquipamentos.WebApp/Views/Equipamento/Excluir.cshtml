@using GestaoDeEquipamentos.Dominio
@using GestaoDeEquipamentos.WebApp.Models

@model ExcluirEquipamentoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Equipamento";
}

<html>
<body data-bs-theme="dark">
    <div>
        <form action="/Equipamento/ExcluirConfirmado/@Model.Id" method="post">
            <p class="fw-bold">Deseja realmente excluir o registro "@Model.Nome"?</p>

            <a class="btn btn-secondary" href="/Equipamento">Voltar</a>
            <button class="btn btn-danger">Excluir</button>
        </form>
    </div>
</body>
</html>