@using GestaoDeEquipamentos.Dominio
@using GestaoDeEquipamentos.WebApp.Models

@model EditarEquipamentoViewModel;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Equipamento";
}

<html>
<body data-bs-theme="dark">
    <main class="container my-2">
        <form class="col-4" action="/Equipamento/Editar/@Model.Id" method="post">
            <div class="mb-3">
                <label for="Nome" class="form-label">Nome:</label>
                <input name="Nome" type="text" value="@Model.Nome" class="form-control">
            </div>

            <div class="mb-3">
                <label for="NumeroSerie" class="form-label">Número de Série:</label>
                <input name="NumeroSerie" type="number" value="@Model.NumeroSerie" class="form-control">
            </div>

            <div class="mb-3">
                <label for="Preco" class="form-label">Preço:</label>
                <input name="Preco" class="form-control" type="text" value="@Model.Preco.ToString("F2")" pattern="^\d+([,\.]\d{1,2})?$">
            </div>

            <div class="mb-3">
                <label for="DataFabricacao" class="form-label">Data de Fabricação:</label>
                <input name="DataFabricacao" type="date" value="@Model.DataFabricacao.ToString("yyyy-MM-dd")" class="form-control">
            </div>

            <div class="mb-3">
                <label for="FabricanteID" class="form-label">Fabricante:</label>
                <select class="form-select" name="FabricanteId">
                    @foreach (SelecionarFabricanteViewModel f in Model.Fabricantes)
                    {
                        <option value="@f.Id">@f.Nome</option>
                    }
                </select>
            </div>

            <div class="d-flex justify-content-end">
                <a class="btn btn-secondary px-4 me-1" href="/Equipamento">Voltar</a>
                <button class="btn btn-success px-4" type="submit">Salvar</button>
            </div>
        </form>
    </main>

</body>

</html>